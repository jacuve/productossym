{% extends 'base.html.twig' %}

{% block title %}{{ code }} {{ title }}{% endblock %}

{% block body %}
<div class="container text-center error-page">
    <div class="error-code">{{ code }}</div>
    <h1>{{ title }}</h1>
    <p class="error-message">{{ message }}</p>
    <div class="error-actions">
        <a href="{{ path('app_home') }}" class="btn btn-primary">Volver al Inicio</a>
        <a href="javascript:history.back()" class="btn">Volver Atrás</a>
    </div>
</div>
{% endblock %}
