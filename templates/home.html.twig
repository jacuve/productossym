{# templates/home.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
    <h1>Productos</h1>
    <ul>
        {% for producto in productos %}
            <li>
                <a href="{{ path('app_detail', {'id': producto.id}) }}">
                    {{ producto.nombre }} - {{ producto.precio }}€
                </a>
            </li>
        {% else %}
            <li>No hay productos disponibles</li>
        {% endfor %}
    </ul>
{% endblock %}
