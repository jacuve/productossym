<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        <style>
            * { box-sizing: border-box; margin: 0; padding: 0; }
            body { 
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
                line-height: 1.6; 
                color: #e0e0e0;
                background: #000000;
            }
            .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
            h1 { margin-bottom: 20px; color: #00e5ff; font-size: 2rem; font-weight: 600; }
            h2 { margin: 20px 0 10px; color: #00e5ff; }
            .alert { padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; }
            .alert-success { background: #1b4332; color: #95d5b2; border: 1px solid #40916c; }
            .alert-warning { background: #3d3400; color: #ffe066; border: 1px solid #bfa200; }
            .btn { 
                display: inline-block; 
                padding: 8px 16px; 
                border: none; 
                border-radius: 4px; 
                cursor: pointer; 
                text-decoration: none; 
                font-size: 14px;
                transition: opacity 0.2s;
            }
            .btn:hover { opacity: 0.85; }
            .btn-primary { background: #3949ab; color: white; }
            .btn-secondary { background: #00e5ff; color: #000; }
            .btn-sm { padding: 4px 10px; font-size: 12px; }
            .btn-danger { background: #c62828; color: white; }
            .actions { margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
            .search-form { margin-bottom: 20px; display: flex; gap: 10px; }
            .search-form input { 
                padding: 10px 14px; 
                border: 1px solid #333; 
                border-radius: 4px; 
                flex: 1; 
                background: #1a1a1a;
                color: #e0e0e0;
            }
            .search-form input:focus { outline: none; border-color: #00e5ff; }
            .product-table { 
                width: 100%; 
                border-collapse: collapse; 
                margin-bottom: 20px; 
                background: #0d0d0d;
                border-radius: 8px;
                overflow: hidden;
            }
            .product-table th, .product-table td { padding: 14px 12px; text-align: left; border-bottom: 1px solid #333; }
            .product-table th { 
                background: #1a1a1a; 
                color: #00e5ff; 
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.85rem;
                letter-spacing: 0.5px;
            }
            .product-table tr:hover { background: #141414; }
            .product-table .stock-bajo { background: #3d3400; }
            .form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; margin-bottom: 16px; }
            .form-group { margin-bottom: 16px; }
            .form-group label { display: block; margin-bottom: 6px; font-weight: 500; color: #00e5ff; }
            .form-group input, .form-group textarea, .form-group select { 
                width: 100%; 
                padding: 10px 12px; 
                border: 1px solid #333; 
                border-radius: 4px; 
                background: #1a1a1a;
                color: #e0e0e0;
            }
            .form-group input:focus, .form-group textarea:focus, .form-group select:focus { 
                outline: none; 
                border-color: #00e5ff;
            }
            .full-width { grid-column: 1 / -1; }
            .form-actions { margin-top: 20px; display: flex; gap: 10px; }
            .detail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 20px; }
            .detail-item { 
                padding: 16px; 
                background: #0d0d0d; 
                border-radius: 8px; 
                border-left: 3px solid #00e5ff;
            }
            .detail-item strong { color: #00e5ff; display: block; margin-bottom: 4px; font-size: 0.85rem; }
            .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; }
            .badge-warning { background: #3d3400; color: #ffe066; }
            a { color: #00e5ff; text-decoration: none; }
            a:hover { color: #84ffff; }
            .product-table td a { color: #00e5ff; }
            .product-table td a:hover { color: #84ffff; }
            .error { color: #ef5350; font-size: 0.875rem; margin-top: 4px; }
            .page-title {
                background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
                padding: 20px;
                border-radius: 8px;
                border-left: 4px solid #00e5ff;
                margin-bottom: 24px;
            }
            .pagination { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 20px; }
            .pagination a { 
                padding: 8px 16px; 
                background: #1a1a1a; 
                border-radius: 4px;
                color: #00e5ff;
            }
            .pagination a:hover { background: #262626; }
            .pagination span { color: #666; }
        </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>